{
  "name": "@comchatx/cx-amazon-ads",
  "version": "0.1.5",
  "description": "Pauses keywords that don't sell, and tunes budgets and bids.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-amazon-ads#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-amazon-ads.git"
  },
  "bugs": "https://github.com/comchatx/cx-amazon-ads/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "skills",
    "prompts",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "name": "Amazon Ads",
    "about": "暂停只花钱不出单的关键词，替你调整预算和竞价。",
    "mark": {
      "line": "layout"
    },
    "section": "data",
    "order": 21,
    "skills": {
      "amazon-ads": {
        "zh": "通过亚马逊的 Ads API 读取并更新你在每个授权区域的亚马逊广告，包括广告活动、广告组、关键词、预算、竞价和报告。"
      }
    },
    "prompts": {
      "spend-this-week": {
        "zh": "按广告活动查看最近 7 天的花费和销售额"
      },
      "out-of-budget": {
        "zh": "找出预算不够用的广告活动"
      },
      "wasted-keywords": {
        "zh": "找出只花钱不出单的关键词"
      }
    },
    "source": {
      "name": "amazon-ads",
      "help": "https://advertising.amazon.com/API/docs/en-us/guides/account-management/authorization/authorization-grants",
      "aspects": {},
      "fields": {
        "client_id": {
          "en": "Client identifier",
          "zh": "Client identifier"
        },
        "client_secret": {
          "en": "Client secret",
          "zh": "Client secret"
        },
        "refresh_token": {
          "en": "Refresh token",
          "zh": "Refresh token"
        }
      },
      "lines": {
        "add": {
          "en": "Add ad accounts",
          "zh": "添加广告账号"
        },
        "connected": {
          "en": "Ad accounts connected.",
          "zh": "广告账号已连接。"
        },
        "removedWith": {
          "en": "Its ad accounts {names} are removed with it.",
          "zh": "它的广告账号 {names} 会一并移除。"
        },
        "refused": {
          "en": "Amazon no longer accepts this refresh token. Add a new one, then remove this one.",
          "zh": "亚马逊已不接受这个 Refresh token，请添加新的，再移除这一行。"
        },
        "none": {
          "en": "Amazon listed no ad account.",
          "zh": "亚马逊没有列出广告账号。"
        },
        "silent": {
          "en": "Amazon did not answer for {regions}, so this list may be incomplete.",
          "zh": "亚马逊没有返回{regions}的广告账号，这里可能不全。"
        }
      }
    }
  },
  "dependencies": {
    "cx-sources": "^0.1.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
